{
  "name": "future-ai-learning-companion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-judge-docs.mjs",
    "dev": "vite --config frontend/vite.config.ts --host 127.0.0.1",
    "prebuild": "node scripts/sync-judge-docs.mjs",
    "build": "tsc -b frontend && vite --config frontend/vite.config.ts build",
    "preview": "vite --config frontend/vite.config.ts preview --host 127.0.0.1",
    "typecheck": "tsc -b frontend --pretty false",
    "test:visual": "node scripts/visual-audit.mjs",
    "test:interactions": "node scripts/interaction-audit.mjs",
    "test:categories": "node scripts/resource-category-audit.mjs",
    "test:learning": "node scripts/learning-audit.mjs",
    "test:dashboards": "node scripts/dashboard-audit.mjs",
    "test:api-client": "node scripts/api-client-audit.mjs",
    "test:integration": "node scripts/integration-audit.mjs",
    "test:browser": "npm run test:learning && npm run test:categories && npm run test:dashboards && npm run test:interactions && npm run test:integration && npm run test:visual"
  },
  "dependencies": {
    "@chakra-ui/react": "2.10.9",
    "@emotion/react": "11.13.5",
    "@emotion/styled": "11.13.5",
    "@fontsource/noto-sans-tc": "5.1.1",
    "@tanstack/react-query": "5.62.7",
    "echarts": "6.1.0",
    "echarts-for-react": "3.0.6",
    "framer-motion": "11.15.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.54.2",
    "react-router-dom": "7.18.3",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.2",
    "vite": "6.4.3"
  }
}
