FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    ANONYMIZED_TELEMETRY=False \
    APP_DATA_DIR=/var/lib/futureai/data \
    CHROMA_PATH=/var/lib/futureai/chroma

RUN apt-get update \
    && apt-get install --no-install-recommends -y libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 futureai \
    && useradd --uid 10001 --gid 10001 --no-create-home futureai \
    && mkdir -p /var/lib/futureai/data /var/lib/futureai/chroma \
    && chown -R 10001:10001 /var/lib/futureai

WORKDIR /app
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/app ./app
COPY backend/scripts ./scripts
COPY backend/data/curriculum ./data/curriculum
COPY backend/data/policies ./data/policies
COPY backend/data/alerts ./data/alerts
COPY deploy/backend-entrypoint.py ./start.py

USER 10001:10001
EXPOSE 8000
ENTRYPOINT ["python", "/app/start.py"]
