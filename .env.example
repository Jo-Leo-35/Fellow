# Generate a private copy with: python3 scripts/create-demo-env.py
# Empty access codes intentionally prevent startup until configured.
WEB_BIND=127.0.0.1
WEB_PORT=8080
RUNTIME_MODE=offline_demo
APP_ENV=production
DEMO_ACCESS_CODES={}
FRONTEND_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
ANONYMIZED_TELEMETRY=False

# Server only. Leave empty for the current Fake Demo.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=

AUTH_SESSION_TTL_MINUTES=480
AUTH_EXCHANGE_RATE_LIMIT_REQUESTS=10
AUTH_EXCHANGE_RATE_LIMIT_WINDOW_SECONDS=60
AGENT_RATE_LIMIT_REQUESTS=30
AGENT_RATE_LIMIT_WINDOW_SECONDS=60
MAX_JSON_BODY_BYTES=65536
MAX_MULTIPART_BODY_BYTES=6291456
AGENT_DEADLINE_SECONDS=45
AGENT_RESERVATION_TTL_SECONDS=90
IDEMPOTENCY_TTL_HOURS=24
MEMORY_SUGGESTION_TTL_HOURS=24
UNATTACHED_UPLOAD_TTL_HOURS=24

# Only needed when running Vite directly against a local backend.
# Docker builds always use the same-origin /api/v1 proxy.
VITE_API_URL=http://localhost:8000/api/v1
